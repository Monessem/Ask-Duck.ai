{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "5.9.14",
  "author": "Ask Duck.ai Contributors",
  "homepage_url": "https://monessem.github.io/Ask-Duck.ai/",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "notifications",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://duck.ai/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://duck.ai/*"],
      "js": ["src/content/duckai-injector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/content-script.js",
        "src/content/content-main.js",
        "src/content/floating-button.js",
        "src/content/action-menu.js",
        "src/content/sidebar.js",
        "src/content/content.css",
        "src/background/messaging.js",
        "src/services/duckai/duckai-client.js",
        "src/services/settings.js",
        "src/services/storage.js",
        "src/services/history.js",
        "src/services/error-handler.js",
        "src/services/custom-prompts.js",
        "src/services/recent-actions.js",
        "src/services/user-prompts.js",
        "src/services/import-export.js",
        "src/services/tab-script.js",
        "src/services/floating-button-controller.js",
        "src/support/support.html",
        "src/support/support.js",
        "src/prompts/prompt-builder.js",
        "src/prompts/actions.js",
        "src/utils/sanitize.js",
        "src/utils/detect.js",
        "src/utils/i18n.js",
        "src/utils/theme.js",
        "src/utils/helpers.js",
        "src/utils/release-notes.js",
        "src/platform/browser-api.js",
        "src/platform/polyfill.js",
        "icons/icon-48.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-duckai-assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "__MSG_commandOpenAssistant__"
    },
    "open-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_commandOpenPopup__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; form-action 'self'; connect-src 'self' https://duck.ai"
  }
}
