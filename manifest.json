{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "5.7.0",
  "author": "Ask Duck.ai Contributors",
  "homepage_url": "https://github.com/Monessem/Duck.ai-Assistant",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "scripts": ["src/background/service-worker.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "notifications",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://duck.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false
    },
    {
      "matches": ["https://duck.ai/*"],
      "js": ["src/content/duckai-injector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/content-main.js",
        "src/content/floating-button.js",
        "src/content/action-menu.js",
        "src/content/sidebar.js",
        "src/content/content.css",
        "src/background/messaging.js",
        "src/services/duckai/duckai-client.js",
        "src/services/settings.js",
        "src/services/storage.js",
        "src/services/history.js",
        "src/services/error-handler.js",
        "src/services/custom-prompts.js",
        "src/services/recent-actions.js",
        "src/services/user-prompts.js",
        "src/services/import-export.js",
        "src/support/support.html",
        "src/support/support.js",
        "src/prompts/prompt-builder.js",
        "src/prompts/actions.js",
        "src/utils/sanitize.js",
        "src/utils/detect.js",
        "src/utils/i18n.js",
        "src/utils/theme.js",
        "src/utils/helpers.js",
        "icons/icon-48.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-duckai-assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "__MSG_commandOpenAssistant__"
    },
    "open-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_commandOpenPopup__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; form-action 'self'; connect-src 'self' https://duck.ai"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "duckai-assistant@duckai-assistant.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
